# Server auth
AUTH_SECRET=sub-administrasi-pembangunan-vercel-auth-secret-2026-64chars
ADMIN_USERNAME=admin
# Password contoh: admin12345. Ganti dengan: npm run hash-password -- password-baru
# Format aman untuk Next.js: karakter $ wajib ditulis sebagai \$.
ADMIN_PASSWORD_HASH=pbkdf2_sha256\$210000\$a4f6aa1938eb175b71c4bb7f6a2e641c\$a084516b5143b344e73e260ea95c4ca1129c89545287fa605146cdcecafadd13
# Alternatif tanpa karakter $ jika env provider bermasalah. Kosongkan jika tidak dipakai.
ADMIN_PASSWORD_HASH_B64=cGJrZGYyX3NoYTI1NiQyMTAwMDAkYTRmNmFhMTkzOGViMTc1YjcxYzRiYjdmNmEyZTY0MWMkYTA4NDUxNmI1MTQzYjM0NGU3M2UyNjBlYTk1YzRjYTExMjljODk1NDUyODdmYTYwNTE0NmNkY2VjYWZhZGQxMw==
SESSION_HOURS=8

# Penyimpanan settings admin. Wajib untuk ganti username dan password dari web di Vercel.
# Pakai Upstash Redis REST API atau Vercel KV REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SETTINGS_KEY=sub_administrasi_auth
FOLDER_LOGO_SETTINGS_KEY=sub_administrasi_folder_logos


# Folder Drive yang menjadi root aplikasi.
# Aplikasi hanya menampilkan isi folder ini, bukan seluruh Google Drive.
NEXT_PUBLIC_DRIVE_ROOT_NAME=SUB ADMINISTRASI PEMBANGUNAN
DRIVE_ROOT_FOLDER_NAME=SUB ADMINISTRASI PEMBANGUNAN
# Lebih stabil jika diisi dengan ID folder SUB ADMINISTRASI PEMBANGUNAN.
DRIVE_ROOT_FOLDER_ID=
# Isi juga versi NEXT_PUBLIC agar tombol "Google Drive" di halaman root bisa muncul.
NEXT_PUBLIC_DRIVE_ROOT_FOLDER_ID=
# Jika Apps Script lama sudah diarahkan langsung ke folder tersebut, biarkan true.
DRIVE_ASSUME_SCRIPT_ROOT_IS_SCOPED=true
# Jumlah item awal yang dimuat. Nilai lebih kecil membuat halaman pertama tampil lebih cepat.
NEXT_PUBLIC_DRIVE_PAGE_SIZE=48
# Cache server singkat agar refresh/pindah folder tidak selalu memanggil Drive ulang.
DRIVE_LIST_CACHE_SECONDS=18

# Pilih: google atau apps-script
DRIVE_PROVIDER=apps-script

# Mode Apps Script, URL lama dari file awal sudah dipasang di sini.
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbw6nMruBdSuLHnt8nGf5Ya2NkIPH5whfrjftj4DoJ8S-aCcPC538W5-ULDECEzB4qRB/exec

# Mode Google Drive API langsung dengan service account.
# Isi jika DRIVE_PROVIDER=google.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SHARED_DRIVE_ID=

# Upload
MAX_UPLOAD_MB=25
MAX_FOLDER_LOGO_MB=5
ALLOWED_UPLOAD_MIME_PREFIXES=image/,video/,application/pdf,application/vnd.google-apps,application/msword,application/vnd.openxmlformats-officedocument,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml,application/zip,text/

# WhatsApp Bot Google Drive
# Aktif/nonaktif dan pengguna bot tetap diatur dari halaman /bot.
# Token API wajib disimpan di server, jangan ditaruh di frontend.
WHATSAPP_API_VERSION=v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=ubah-token-verifikasi-webhook
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_ADMIN_NUMBER=
WHATSAPP_MAX_DIRECT_SEND_MB=20
WHATSAPP_BOT_PAGE_SIZE=20
BOT_SETTINGS_KEY=sub_administrasi_whatsapp_bot_settings
BOT_USERS_KEY=sub_administrasi_whatsapp_bot_users
BOT_LOGS_KEY=sub_administrasi_whatsapp_bot_logs
BOT_STATE_KEY=sub_administrasi_whatsapp_bot_state
BOT_TEMP_KEY=sub_administrasi_whatsapp_bot_temp_files
BOT_LOG_LIMIT=300
